# =====================================================
# SECURITY - JWT TOKENS
# =====================================================
# ⚠️ QUAN TRỌNG: Đổi thành key ngẫu nhiên mạnh, ít nhất 32 ký tự
# Tạo key ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ACCESS_KEY=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_KEY_32_CHARS

# =====================================================
# CLIENT/FRONTEND URL
# =====================================================
# URL của frontend application (để CORS và email links)
# Ví dụ: https://student-manager.vercel.app
CLIENT_URL=https://YOUR_FRONTEND_DOMAIN_HERE

# =====================================================
# EMAIL SERVICE (cho chức năng Forgot Password)
# =====================================================
# Gmail configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-app-email@gmail.com
EMAIL_PASS=your-gmail-app-specific-password

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# =====================================================
# MONGODB (nếu có sử dụng)
# =====================================================
# MONGODB_ATLAS_URL=mongodb+srv://username:password@cluster.mongodb.net/database

# =====================================================
# OPTIONAL - LOGGING & MONITORING
# =====================================================
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-here

# =====================================================
# HƯỚNG DẪN TẠO GMAIL APP PASSWORD
# =====================================================
# 1. Vào Google Account: https://myaccount.google.com/
# 2. Security → 2-Step Verification (bật nếu chưa bật)
# 3. Security → App passwords
# 4. Tạo app password cho "Mail" và "Other (Custom name)"
# 5. Copy mật khẩu 16 ký tự vào EMAIL_PASS

# =====================================================
# HƯỚNG DẪN TẠO JWT SECRET KEY
