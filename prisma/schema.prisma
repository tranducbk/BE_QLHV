generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model achievement_profiles {
  id                         String    @id @db.Uuid
  studentId                  String    @unique @db.Uuid
  totalYears                 Int?      @default(0)
  totalAdvancedSoldier       Int?      @default(0)
  totalCompetitiveSoldier    Int?      @default(0)
  totalScientificTopics      Int?      @default(0)
  totalScientificInitiatives Int?      @default(0)
  eligibleForMinistryReward  Boolean?  @default(false)
  eligibleForNationalReward  Boolean?  @default(false)
  createdAt                  DateTime? @db.Timestamptz(6)
  updatedAt                  DateTime? @db.Timestamptz(6)
  students                   students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model achievements {
  id          String    @id @db.Uuid
  studentId   String    @db.Uuid
  semester    String?   @db.VarChar(255)
  schoolYear  String?   @db.VarChar(255)
  content     String?
  year        Int?
  title       String?   @db.VarChar(255)
  description String?
  award       String?   @db.VarChar(255)
  createdAt   DateTime? @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
  students    students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model classes {
  id               String            @id @db.Uuid
  className        String            @db.VarChar(255)
  studentCount     Int?              @default(0)
  createdAt        DateTime?         @db.Timestamptz(6)
  updatedAt        DateTime?         @db.Timestamptz(6)
  educationLevelId String?           @db.Uuid
  education_levels education_levels? @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  students         students[]
}

model commander_duty_schedules {
  id          Int      @id @default(autoincrement())
  fullName    String   @db.VarChar(255)
  rank        String?  @db.VarChar(255)
  phoneNumber String?  @db.VarChar(255)
  position    String?  @db.VarChar(255)
  workDay     DateTime @db.Timestamptz(6)
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @db.Timestamptz(6)
}

model commanders {
  id                      String    @id @db.Uuid
  commanderId             String?   @db.VarChar(255)
  fullName                String?   @db.VarChar(255)
  gender                  String?   @db.VarChar(255)
  birthday                DateTime? @db.Timestamptz(6)
  placeOfBirth            String?   @db.VarChar(255)
  hometown                String?   @db.VarChar(255)
  ethnicity               String?   @db.VarChar(255)
  religion                String?   @db.VarChar(255)
  currentAddress          String?   @db.VarChar(255)
  email                   String?   @db.VarChar(255)
  phoneNumber             String?   @db.VarChar(255)
  cccd                    String?   @db.VarChar(255)
  partyCardNumber         String?   @db.VarChar(255)
  startWork               Int?
  organization            String?   @db.VarChar(255)
  unit                    String?   @db.VarChar(255)
  rank                    String?   @db.VarChar(255)
  positionGovernment      String?   @db.VarChar(255)
  positionParty           String?   @db.VarChar(255)
  fullPartyMember         DateTime? @db.Timestamptz(6)
  probationaryPartyMember DateTime? @db.Timestamptz(6)
  dateOfEnlistment        DateTime? @db.Timestamptz(6)
  avatar                  String?   @default("https://i.pinimg.com/736x/d4/a1/ff/d4a1ff9d0f243e50062e2b21f2f2496d.jpg") @db.VarChar(255)
  createdAt               DateTime? @db.Timestamptz(6)
  updatedAt               DateTime? @db.Timestamptz(6)
  users                   users[]
}

model cut_rice {
  id              String    @id @db.Uuid
  studentId       String    @unique @db.Uuid
  weekly          Json      @default("{}")
  isAutoGenerated Boolean?  @default(true)
  lastUpdated     DateTime? @db.Timestamptz(6)
  notes           String?   @db.VarChar(255)
  createdAt       DateTime? @db.Timestamptz(6)
  updatedAt       DateTime? @db.Timestamptz(6)
  students        students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model education_levels {
  id             String         @id @db.Uuid
  levelName      String         @db.VarChar(255)
  createdAt      DateTime?      @db.Timestamptz(6)
  updatedAt      DateTime?      @db.Timestamptz(6)
  organizationId String?        @db.Uuid
  classes        classes[]
  organizations  organizations? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       students[]
}

model notifications {
  id        String    @id @db.Uuid
  studentId String    @db.Uuid
  title     String    @db.VarChar(255)
  content   String?
  type      String?   @db.VarChar(255) // "new_semester", "update_info", "tuition_fee", "party_rating", "training_rating"
  link      String?   @db.VarChar(255) // URL to navigate when clicked
  isRead    Boolean?  @default(false)
  createdAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
  students  students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model admin_notifications {
  id          String    @id @db.Uuid
  studentId   String    @db.Uuid
  studentName String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  content     String?
  type        String?   @db.VarChar(255) // "student_update_grade", "student_update_tuition", "student_update_profile"
  link        String?   @db.VarChar(255) // URL to navigate when clicked
  isRead      Boolean?  @default(false)
  createdAt   DateTime? @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
}

model organizations {
  id               String             @id @db.Uuid
  organizationName String             @db.VarChar(255)
  travelTime       Int                @default(45)
  totalStudents    Int?               @default(0)
  status           String?            @default("active") @db.VarChar(255)
  createdAt        DateTime?          @db.Timestamptz(6)
  updatedAt        DateTime?          @db.Timestamptz(6)
  universityId     String?            @db.Uuid
  education_levels education_levels[]
  universities     universities?      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  students         students[]
}

model scientific_initiatives {
  id                  String              @id @db.Uuid
  yearlyAchievementId String              @db.Uuid
  title               String              @db.VarChar(255)
  description         String?
  year                Int
  status              String              @default("pending") @db.VarChar(255)
  createdAt           DateTime?           @db.Timestamptz(6)
  updatedAt           DateTime?           @db.Timestamptz(6)
  yearly_achievements yearly_achievements @relation(fields: [yearlyAchievementId], references: [id], onDelete: Cascade)
}

model scientific_topics {
  id                  String              @id @db.Uuid
  yearlyAchievementId String              @db.Uuid
  title               String              @db.VarChar(255)
  description         String?
  year                Int
  status              String              @default("pending") @db.VarChar(255)
  createdAt           DateTime?           @db.Timestamptz(6)
  updatedAt           DateTime?           @db.Timestamptz(6)
  yearly_achievements yearly_achievements @relation(fields: [yearlyAchievementId], references: [id], onDelete: Cascade)
}

model semester_results {
  id                String            @id @db.Uuid
  studentId         String            @db.Uuid
  semester          String            @db.VarChar(255)
  schoolYear        String            @db.VarChar(255)
  yearlyResultId    String?           @db.Uuid
  totalCredits      Int?              @default(0)
  averageGrade4     Float?            @default(0)
  averageGrade10    Float?            @default(0)
  cumulativeCredits Int?              @default(0)
  cumulativeGrade4  Float?            @default(0)
  cumulativeGrade10 Float?            @default(0)
  debtCredits       Int?              @default(0)
  failedSubjects    Int?              @default(0)
  createdAt         DateTime?         @db.Timestamptz(6)
  updatedAt         DateTime?         @db.Timestamptz(6)
  students          students          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  yearly_results    yearly_results?   @relation(fields: [yearlyResultId], references: [id])
  subject_results   subject_results[]

  @@unique([studentId, semester, schoolYear], map: "semester_results_student_id_semester_school_year")
}

model semesters {
  id         String    @id @db.Uuid
  code       String    @db.VarChar(255)
  schoolYear String    @db.VarChar(255)
  createdAt  DateTime? @db.Timestamptz(6)
  updatedAt  DateTime? @db.Timestamptz(6)

  @@unique([code, schoolYear], map: "semesters_code_school_year")
}

model students {
  id                      String                @id @db.Uuid
  studentId               String?               @unique @db.VarChar(255)
  fullName                String?               @unique @db.VarChar(255)
  gender                  String?               @db.VarChar(255)
  birthday                DateTime?             @db.Timestamptz(6)
  hometown                String?               @db.VarChar(255)
  ethnicity               String?               @db.VarChar(255)
  religion                String?               @db.VarChar(255)
  currentAddress          String?               @db.VarChar(255)
  placeOfBirth            String?               @db.VarChar(255)
  phoneNumber             String?               @db.VarChar(255)
  email                   String?               @db.VarChar(255)
  cccdNumber              String?               @db.VarChar(255)
  partyMemberCardNumber   String?               @db.VarChar(255)
  enrollment              Int?
  graduationDate          DateTime?             @db.Timestamptz(6)
  unit                    String?               @db.VarChar(255)
  rank                    String?               @db.VarChar(255)
  positionGovernment      String?               @db.VarChar(255)
  positionParty           String?               @db.VarChar(255)
  fullPartyMember         DateTime?             @db.Timestamptz(6)
  probationaryPartyMember DateTime?             @db.Timestamptz(6)
  dateOfEnlistment        DateTime?             @db.Timestamptz(6)
  avatar                  String?               @default("https://i.pinimg.com/736x/81/09/3a/81093a0429e25b0ff579fa41aa96c421.jpg") @db.VarChar(255)
  currentCpa4             Float?                @default(0)
  currentCpa10            Float?                @default(0)
  familyMembers           Json?
  foreignRelations        Json?
  createdAt               DateTime?             @db.Timestamptz(6)
  updatedAt               DateTime?             @db.Timestamptz(6)
  classId                 String?               @db.Uuid
  organizationId          String?               @db.Uuid
  universityId            String?               @db.Uuid
  educationLevelId        String?               @db.Uuid
  achievement_profiles    achievement_profiles?
  achievements            achievements[]
  cut_rice                cut_rice?
  notifications           notifications[]
  semester_results        semester_results[]
  classes                 classes?              @relation(fields: [classId], references: [id])
  education_levels        education_levels?     @relation(fields: [educationLevelId], references: [id])
  organizations           organizations?        @relation(fields: [organizationId], references: [id])
  universities            universities?         @relation(fields: [universityId], references: [id])
  time_tables             time_tables[]
  tuition_fees            tuition_fees[]
  users                   users[]
  yearly_achievements     yearly_achievements[]
  yearly_results          yearly_results[]
}

model subject_results {
  id               String           @id @db.Uuid
  semesterResultId String           @db.Uuid
  subjectCode      String           @db.VarChar(255)
  subjectName      String           @db.VarChar(255)
  credits          Int
  letterGrade      String           @db.VarChar(255)
  gradePoint4      Float
  gradePoint10     Float
  createdAt        DateTime?        @db.Timestamptz(6)
  updatedAt        DateTime?        @db.Timestamptz(6)
  semester_results semester_results @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)
}

model time_tables {
  id        String    @id @db.Uuid
  studentId String    @db.Uuid
  schedules Json      @default("[]")
  createdAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
  students  students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model tuition_fees {
  id          String    @id @db.Uuid
  studentId   String    @db.Uuid
  totalAmount Decimal   @db.Decimal(18, 2)
  semester    String?   @db.VarChar(255)
  schoolYear  String?   @db.VarChar(255)
  content     String?   @db.VarChar(255)
  status      String?   @db.VarChar(255)
  createdAt   DateTime? @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
  students    students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model universities {
  id             String          @id @db.Uuid
  universityCode String          @unique @db.VarChar(255)
  universityName String          @db.VarChar(255)
  totalStudents  Int?            @default(0)
  status         String?         @default("active") @db.VarChar(255)
  createdAt      DateTime?       @db.Timestamptz(6)
  updatedAt      DateTime?       @db.Timestamptz(6)
  organizations  organizations[]
  students       students[]
}

model users {
  id          String      @id @db.Uuid
  username    String      @unique @db.VarChar(255)
  password    String      @db.VarChar(255)
  isAdmin     Boolean?    @default(false)
  role        String?     @default("USER") @db.VarChar(50) // SUPER_ADMIN, ADMIN, USER
  studentId   String?     @db.Uuid
  commanderId String?     @db.Uuid
  createdAt   DateTime?   @db.Timestamptz(6)
  updatedAt   DateTime?   @db.Timestamptz(6)
  deletedAt   DateTime?   @db.Timestamptz(6)
  commanders  commanders? @relation(fields: [commanderId], references: [id])
  students    students?   @relation(fields: [studentId], references: [id])
}

model yearly_achievements {
  id                     String                   @id @db.Uuid
  studentId              String                   @db.Uuid
  year                   Int
  decisionNumber         String?                  @db.VarChar(255)
  decisionDate           DateTime?                @db.Timestamptz(6)
  title                  String                   @db.VarChar(255)
  hasMinistryReward      Boolean?                 @default(false)
  hasNationalReward      Boolean?                 @default(false)
  notes                  String?
  createdAt              DateTime?                @db.Timestamptz(6)
  updatedAt              DateTime?                @db.Timestamptz(6)
  scientific_initiatives scientific_initiatives[]
  scientific_topics      scientific_topics[]
  students               students                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model yearly_results {
  id                          String             @id @db.Uuid
  studentId                   String             @db.Uuid
  schoolYear                  String             @db.VarChar(255)
  averageGrade4               Float?             @default(0)
  averageGrade10              Float?             @default(0)
  cumulativeGrade4            Float?             @default(0)
  cumulativeGrade10           Float?             @default(0)
  cumulativeCredits           Int?               @default(0)
  totalCredits                Int?               @default(0)
  totalSubjects               Int?               @default(0)
  passedSubjects              Int?               @default(0)
  failedSubjects              Int?               @default(0)
  debtCredits                 Int?               @default(0)
  academicStatus              String?            @db.VarChar(255)
  studentLevel                Int?               @default(1)
  semesterIds                 String[]           @default([]) @db.Uuid
  partyRating                 String?            @db.VarChar(255)
  trainingRating              String?            @db.VarChar(255)
  partyRatingDecisionNumber   String?            @db.VarChar(255)
  createdAt                   DateTime?          @db.Timestamptz(6)
  updatedAt                   DateTime?          @db.Timestamptz(6)
  semester_results            semester_results[]
  students                    students           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYear], map: "yearly_results_student_id_school_year")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "ERD.svg"
}

